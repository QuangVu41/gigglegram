  "description": "",
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.8.2",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "date-fns": "^4.1.0"
  }
}
