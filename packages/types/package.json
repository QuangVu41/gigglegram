{
  "name": "@repo/types",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "proto:gen": "npx protoc --plugin=../../node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./ --ts_proto_opt=nestJs=true --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=addNestjsRestParameter=true ./src/proto/auth.proto"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "author": "",
