{
  "name": "@repo/types",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint . --max-warnings 0",
    "proto:gen": "npx protoc --plugin=../../node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./ --ts_proto_opt=nestJs=true --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=addNestjsRestParameter=true ./src/proto/auth/auth.proto"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./src/auth/permissions.ts",
      "default": "./dist/auth/permissions.js"
    },
    "./common": {
      "types": "./src/common/find-many-query.dto.ts",
      "default": "./dist/common/find-many-query.dto.js"
    }
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.8.2",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/microservices": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "better-auth": "1.4.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3"
  }
}
