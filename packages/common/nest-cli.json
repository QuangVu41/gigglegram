{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "./email/templates",
        "watchAssets": true
      },
      {
        "include": "./upload/*.json",
        "watchAssets": true
      },
      {
        "include": "./moderation/*.json",
        "watchAssets": true
      }
    ]
  }
}
